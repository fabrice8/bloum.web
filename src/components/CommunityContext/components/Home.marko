
import QuestionTagImage from './../../../assets/posts.png'

static function getStatusColor( value ){
  switch( value.toLowerCase() ){
    case 'new': return 'warning'
    case 'open': return 'success'
    case 'close': return 'info'
  }
}

class {
	onCreate({ App }){
		this.state = {
      posts: null,
			activeTags: []
		}

    App.extend(this)
	}
  onMount(){ this.fetchPosts() }
  onFilter( tag ){
    !this.state.activeTags.includes( tag ) ?
                    this.state.activeTags.push( tag )
                    : this.state.activeTags = this.state.activeTags.filter( each => { return each !== tag } )

    this.setStateDirty('activeTags')
  }

  async fetchPosts(){
    try {
      const
      payload = {
        method: 'GET',
        headers: this.App.data.headers
      },
      { error, message, posts } = await this.App.Request(`${this.App.data.baseURL}/community/${this.input.communityId}/posts`, payload )
      if( error ) throw new Error( message )
      
      this.state.posts = posts
    }
    catch( error ){ debugLog('Failed Fetching Community Posts: ', error ) }
  }
}


